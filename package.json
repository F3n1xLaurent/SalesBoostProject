{
  "name": "sales-boost-bot",
  "version": "1.0.0",
  "description": "Telegram bot for evaluating sales managers' expertise",
  "main": "dist/src/index.js",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:admin": "vite dev --config admin-frontend/vite.config.ts",
    "build": "tsc && vite build --config admin-frontend/vite.config.ts",
    "admin:fresh": "npm run build && vite dev --config admin-frontend/vite.config.ts",
    "admin:serve": "npm run build && PORT=8080 tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "auth:create-admin": "tsx scripts/create-admin-account.ts",
    "org:sync-mock": "tsx scripts/sync-mock-organization.ts",
    "regenerate": "tsx scripts/regenerate-evaluations.ts",
    "backfill-training": "tsx scripts/backfill-training-assessments.ts",
    "generate-mock": "tsx scripts/generate-mock-data.ts",
    "delete-mock": "tsx scripts/delete-mock-data.ts",
    "seed-ai-call": "tsx scripts/seed-ai-call-for-user.ts",
    "check-openai": "tsx scripts/check-openai.ts",
    "demo-reports:generate": "tsx scripts/generate-demo-example-reports.ts",
    "test": "vitest run --exclude 'dist/**'",
    "test:watch": "vitest --exclude 'dist/**'",
    "call-test:build": "npm run build -w @smoke/voximplant-smoke && npm run build -w @smoke/vox-smoke-test-server",
    "call-test:dev": "npm run dev -w @smoke/vox-smoke-test-server",
    "call-test:stats": "npm run stats -w @smoke/vox-smoke-test-server"
  },
  "keywords": [
    "telegram",
    "bot",
    "sales",
    "evaluation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "openai": "^4.20.1",
    "prisma": "^5.7.1",
    "telegraf": "^4.15.4",
    "undici": "^7.20.0",
    "ws": "^8.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@heroui/react": "^2.8.9",
    "@ibm/plex": "^6.4.1",
    "@iconify-json/lets-icons": "^1.2.2",
    "@iconify/react": "^6.0.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "autoprefixer": "^10.4.24",
    "effector": "^23.4.4",
    "effector-react": "^23.3.0",
    "framer-motion": "^12.34.3",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.15.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "yarn@4.1.1+sha512.ec40d0639bb307441b945d9467139cbb88d14394baac760b52eca038b330d16542d66fef61574271534ace5a200518dabf3b53a85f1f9e4bfa37141b538a9590"
}

# Separate service; do not add this service to production compose.
PIPECAT_HYPOTHESIS_TOKEN=replace-with-a-long-random-secret
PIPECAT_HYPOTHESIS_PUBLIC_URL=https://your-separate-tunnel.example
OPENAI_API_KEY=
GEMINI_API_KEY=
PROXYAPI_API_KEY=
PIPECAT_GEMINI_PROXYAPI_BASE_URL=https://api.proxyapi.ru
ELEVENLABS_API_KEY=
# Preserve this if the main backend uses it (HTTP and WebSocket).
ELEVENLABS_PROXY_URL=
VOX_ACCOUNT_ID=
VOX_API_KEY=
VOX_APP_ID=
VOX_CALLER_ID=
# Dedicated, manually installed VoxEngine scenario/rule (never a production rule).
PIPECAT_VOX_RULE=voice_pipecat_hypothesis_rule
PIPECAT_LOG_DIR=../../storage/pipecat-hypothesis

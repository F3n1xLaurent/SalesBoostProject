// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Core web identity. This is the future source of truth for auth/RBAC.
/// Existing Telegram-first flow can keep using `User` until the app layer is migrated.
model Account {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  displayName    String?
  status         String   @default("active") // "active" | "invited" | "disabled"
  emailVerifiedAt DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  telegramUsers  User[]
  telegramLinks  TelegramLink[]
  telegramLinkCodes TelegramLinkCode[]
  memberships    AccountMembership[]
  managerProfiles ManagerProfile[]
  phoneNumbers   PhoneNumber[]
  createdPermissionTemplates PermissionTemplate[] @relation("PermissionTemplateCreatedBy")
  permissionTemplateAssignments AccountPermissionTemplateAssignment[]

  @@map("accounts")
}

/// Organizational root: a holding/group of dealerships.
model Holding {
  id          String   @id @default(cuid())
  name        String
  code        String?  @unique
  description String?
  type        String   @default("own") // "own" | "franchised"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dealerships Dealership[]
  memberships AccountMembership[]
  dealershipDirections DealershipDirection[]
  phoneNumberTypes PhoneNumberType[]
  importSources ImportSource[]
  callCustomerProfiles CallCustomerProfile[]
  callScripts CallScript[]
  callPlans CallPlan[]
  trainerSessions TrainerSession[]
  trainerDailyPlans TrainerDailyPlan[]

  @@map("holdings")
}

/// A single dealership belonging to a holding.
model Dealership {
  id          String   @id @default(cuid())
  holdingId   String?
  name        String
  code        String?  @unique
  description String?
  type        String   @default("own") // "own" | "franchised"
  directionsJson String @default("[]")
  city        String?
  address     String?
  workingHoursFrom String   @default("09:00")
  workingHoursTo   String   @default("21:00")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  holding         Holding?            @relation(fields: [holdingId], references: [id], onDelete: SetNull)
  memberships     AccountMembership[]
  managerProfiles ManagerProfile[]
  phoneNumbers    PhoneNumber[]
  voiceCallSessions VoiceCallSession[]
  trainerSessions TrainerSession[]
  trainerDailyPlans TrainerDailyPlan[]

  @@index([holdingId])
  @@map("dealerships")
}

model DealershipDirection {
  id        String   @id @default(cuid())
  holdingId String
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holding   Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  @@unique([holdingId, name])
  @@unique([holdingId, code])
  @@index([holdingId, isActive])
  @@map("dealership_directions")
}

model ImportSource {
  id          String   @id @default(cuid())
  holdingId   String?
  name        String
  url         String
  format      String
  status      String   @default("active")
  schedule    String?
  itemsPath   String
  entityType  String
  aiConfigJson String
  tagRulesJson String @default("[]")
  lastRunAt   DateTime?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       ImportedItem[]
  runs        ImportRun[]
  holding     Holding? @relation(fields: [holdingId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([holdingId])
  @@map("import_sources")
}

model ImportedItem {
  id             String   @id @default(cuid())
  importSourceId String
  externalId     String?
  title          String
  description    String
  rawDataJson    String
  normalizedDataJson String
  tagsJson       String   @default("[]")
  contentHash    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  importSource   ImportSource @relation(fields: [importSourceId], references: [id], onDelete: Cascade)

  @@unique([importSourceId, contentHash])
  @@index([importSourceId])
  @@index([externalId])
  @@map("imported_items")
}

model CallCustomerProfile {
  id                 String   @id @default(cuid())
  holdingId          String
  name               String
  voiceId            String
  age                Int
  ageFrom            Int      @default(35)
  ageTo              Int      @default(35)
  character          String   @default("")
  temperament        String
  patience           String
  replyLength        String
  communicationStyle String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  holding            Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  @@index([holdingId, updatedAt])
  @@map("call_customer_profiles")
}

model CallCustomerVoice {
  id             String   @id
  name           String
  elevenLabsCode String?
  openaiCode     String?
  isEnabled      Boolean  @default(true)
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isDeleted, isEnabled, name])
  @@map("call_customer_voices")
}

model CallReportProblem {
  id        String   @id @default(cuid())
  code      String   @unique
  title     String
  category  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([category])
  @@map("call_report_problem_catalog")
}

model CallScript {
  id                  String   @id @default(cuid())
  holdingId           String
  name                String
  profileIdsJson      String   @default("[]")
  context             String   @default("")
  dataConditionJson   String   @default("{}")
  objectionsJson      String   @default("[]")
  questionsJson       String   @default("[]")
  successCriteriaJson String   @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  holding             Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  trainerSessions     TrainerSession[]

  @@index([holdingId, updatedAt])
  @@map("call_scripts")
}

model CallPlan {
  id                  String   @id @default(cuid())
  holdingId           String
  name                String
  targetType          String   // "employees" | "dealerships"
  targetIdsJson       String   @default("[]")
  scriptId            String
  phoneNumberTypeId   String
  frequency           String   // "daily" | "weekly"
  callTimeFrom        String
  callTimeTo          String
  lastInitiatedAt     DateTime?
  lastBatchId         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  holding             Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  calls               CallPlanCall[]
  voiceCallSessions   VoiceCallSession[]

  @@index([holdingId, updatedAt])
  @@map("call_plans")
}

model CallPlanCall {
  id                  String   @id @default(cuid())
  planId              String
  callId              String   @unique
  employeeId          String?
  employeeName        String?
  dealershipId        String?
  dealershipName      String?
  phone               String
  phoneNumberTypeId   String
  scriptId            String
  profileId           String?
  importedItemId      String?
  promptText          String
  criteriaJson        String   @default("[]")
  status              String   @default("running")
  outcome             String?
  startedAt           DateTime @default(now())
  endedAt             DateTime?
  transcriptJson      String?
  evaluationJson      String?
  totalScore          Float?
  failureReason       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  plan                CallPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, startedAt])
  @@map("call_plan_calls")
}

model ImportRun {
  id             String   @id @default(cuid())
  importSourceId String
  status         String
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  totalItems     Int      @default(0)
  createdItems   Int      @default(0)
  updatedItems   Int      @default(0)
  skippedItems   Int      @default(0)
  errorMessage   String?

  importSource   ImportSource @relation(fields: [importSourceId], references: [id], onDelete: Cascade)

  @@index([importSourceId, startedAt])
  @@map("import_runs")
}

model CityDictionary {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  searchName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([searchName])
  @@map("city_dictionary")
}

model PhoneNumberType {
  id        String   @id @default(cuid())
  holdingId String?
  name      String
  ownership String   // "dealership" | "user"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holding      Holding?      @relation(fields: [holdingId], references: [id], onDelete: SetNull)
  phoneNumbers PhoneNumber[]

  @@index([holdingId])
  @@index([ownership, isActive])
  @@map("phone_number_types")
}

model PhoneNumber {
  id           String   @id @default(cuid())
  typeId       String
  phone        String
  dealershipId String?
  accountId    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  type        PhoneNumberType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  dealership  Dealership?     @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  account     Account?        @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([typeId])
  @@index([dealershipId])
  @@index([accountId])
  @@map("phone_numbers")
}

/// Business profile of a dealership employee/manager.
/// Optional links let us migrate gradually from the current Telegram `User` model.
model ManagerProfile {
  id              String   @id @default(cuid())
  dealershipId    String
  accountId       String?
  telegramUserId  Int?     @unique
  fullName        String
  email           String?
  phone           String?
  status          String   @default("active") // "active" | "inactive"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dealership      Dealership @relation(fields: [dealershipId], references: [id], onDelete: Cascade)
  account         Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  telegramUser    User?      @relation("TelegramUserManagerProfile", fields: [telegramUserId], references: [id], onDelete: SetNull)
  voiceCallSessions VoiceCallSession[]
  trainerSessions TrainerSession[]
  trainerScores TrainerScore[]
  trainerStreak TrainerStreak?
  trainerDailyPlans TrainerDailyPlan[]

  @@index([dealershipId])
  @@index([accountId])
  @@map("manager_profiles")
}

/// Scope-aware role assignment. This is the RBAC layer:
/// - platform_superadmin => holdingId/dealershipId are null
/// - holding_admin       => holdingId is set
/// - dealership_admin    => dealershipId is set
/// - manager             => dealershipId is set
model AccountMembership {
  id           String   @id @default(cuid())
  accountId    String
  role         String   // "platform_superadmin" | "holding_admin" | "dealership_admin" | "manager"
  holdingId    String?
  dealershipId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account      Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  holding      Holding?   @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  dealership   Dealership? @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  @@index([accountId, role])
  @@index([holdingId, role])
  @@index([dealershipId, role])
  @@unique([accountId, role, holdingId, dealershipId])
  @@map("account_memberships")
}

model PermissionTemplate {
  id                String   @id @default(cuid())
  name              String
  description       String?
  permissionsJson   String   // JSON array of permission keys
  isSystem          Boolean  @default(false)
  createdByAccountId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdBy         Account? @relation("PermissionTemplateCreatedBy", fields: [createdByAccountId], references: [id], onDelete: SetNull)
  assignments       AccountPermissionTemplateAssignment[]

  @@unique([name])
  @@index([createdByAccountId])
  @@map("permission_templates")
}

model AccountPermissionTemplateAssignment {
  id          String   @id @default(cuid())
  accountId   String
  templateId  String
  createdAt   DateTime @default(now())

  account     Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  template    PermissionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([accountId, templateId])
  @@index([accountId])
  @@index([templateId])
  @@map("account_permission_template_assignments")
}

/// Explicit Telegram<->Account binding for a future account-first auth flow.
/// Kept separate from `User` so the current Telegram bot logic can keep running during migration.
model TelegramLink {
  id               String   @id @default(cuid())
  accountId        String
  telegramId       String   @unique
  telegramUsername String?
  linkedAt         DateTime @default(now())
  lastSeenAt       DateTime?

  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("telegram_links")
}

/// One-time code to link a logged-in web account with Telegram via the bot.
model TelegramLinkCode {
  id          String   @id @default(cuid())
  accountId   String
  code        String   @unique
  purpose     String   @default("link_telegram")
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose])
  @@index([expiresAt])
  @@map("telegram_link_codes")
}

model User {
  id              Int      @id @default(autoincrement())
  telegramId      String   @unique
  fullName        String
  role            String   @default("manager") // "manager" | "admin"
  preferencesJson String?  // { replyMode: "text"|"voice", ttsVoice: "male"|"female" }
  accountId       String?
  createdAt       DateTime @default(now())

  attempts         Attempt[]
  trainingSessions TrainingSession[]
  account          Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  managerProfile   ManagerProfile? @relation("TelegramUserManagerProfile")

  @@index([accountId])
  @@map("users")
}

model TrainingSession {
  id               Int       @id @default(autoincrement())
  userId           Int
  // "assigned" | "in_progress" | "completed" | "cancelled" | "failed"
  status           String
  // "normal" | "thorough" | "pressure"
  clientProfile    String    @default("normal")
  // JSON: extended dialog state (phase, topics, checklist, health, etc.)
  stateJson        String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?
  // Legacy assessment fields (kept for backward compatibility)
  assessmentScore  Float?    // 0-100
  assessmentJson   String?   // JSON: legacy training assessment
  // V2 evaluation fields
  failureReason    String?   // "poor_communication" | "ignored_questions" | "rude_language" | "repeated_low_effort" | "critical_evasion:topic"
  evaluationJson   String?   // Strict V2 JSON: { overall_score_0_100, dimension_scores, checklist, issues, recommendations }
  totalScore       Float?    // 0-100, deterministic score from evaluator

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages DialogMessage[]

  @@map("training_sessions")
}

model TrainerSession {
  id                     String    @id @default(cuid())
  employeeId             String
  branchId               String?
  companyId              String?
  sessionType            String    // "plan" | "free"
  scenarioId             String?
  status                 String    @default("in_progress") // "in_progress" | "completed" | "cancelled" | "failed" | "paused"
  difficulty             String    @default("medium") // "easy" | "medium" | "hard"
  clientType             String?   // "random" | configured client category
  elevenLabsConversationId String?
  caseContextJson        String    @default("{}")
  transcriptJson         String    @default("[]")
  evaluationJson         String?
  dimensionsJson         String?
  checklistResultsJson   String?
  objectionsAnalysisJson String?
  topRecommendationsJson String?
  score                  Float?
  baseScore              Float?
  multiplier             Float     @default(1)
  finalPoints            Int?
  durationSec            Int?
  failureReason          String?
  startedAt              DateTime  @default(now())
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  employee               ManagerProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch                 Dealership?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  company                Holding?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  scenario               CallScript?    @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  scoreEntry             TrainerScore?

  @@index([employeeId, startedAt])
  @@index([branchId, startedAt])
  @@index([companyId, startedAt])
  @@index([scenarioId, startedAt])
  @@index([elevenLabsConversationId])
  @@index([sessionType, status])
  @@map("trainer_sessions")
}

model TrainerScore {
  id               String   @id @default(cuid())
  employeeId       String
  trainerSessionId String   @unique
  baseScore        Float
  multiplier       Float
  finalScore       Int
  earnedAt         DateTime @default(now())

  employee         ManagerProfile  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  trainerSession   TrainerSession  @relation(fields: [trainerSessionId], references: [id], onDelete: Cascade)

  @@index([employeeId, earnedAt])
  @@map("trainer_scores")
}

model TrainerStreak {
  employeeId       String   @id
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  lastActiveDate   String?
  updatedAt        DateTime @updatedAt

  employee         ManagerProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("trainer_streaks")
}

model TrainerDailyPlan {
  id               String   @id @default(cuid())
  employeeId       String
  companyId        String?
  branchId         String?
  planDate         String
  sessionsJson     String   @default("[]")
  generatedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employee         ManagerProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company          Holding?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  branch           Dealership?    @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([employeeId, planDate])
  @@index([companyId, planDate])
  @@index([branchId, planDate])
  @@map("trainer_daily_plans")
}

model DialogMessage {
  id        Int      @id @default(autoincrement())
  sessionId Int
  role      String   // "client" | "manager"
  content   String
  source    String   @default("text") // "text" | "voice"
  voiceFileId      String?
  voiceDurationSec Int?
  qualitySignalJson String? // JSON: { very_short, nonsense, profanity, filler_count, anglicism_count }
  createdAt DateTime @default(now())

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("dialog_messages")
}

model Test {
  id                    Int       @id @default(autoincrement())
  title                 String
  isActive              Boolean   @default(true)
  useVirtualCustomer    Boolean   @default(false)
  virtualCustomerConfigJson String? // JSON: { car: {...}, dealership: "..." }
  createdAt             DateTime  @default(now())

  steps   TestStep[]
  attempts Attempt[]

  @@map("tests")
}

model TestStep {
  id               Int    @id @default(autoincrement())
  testId           Int
  order            Int
  customerMessage  String
  stepGoal         String
  scoringFocusJson String // JSON array of criteria codes

  test           Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  attemptAnswers AttemptAnswer[]

  @@unique([testId, order])
  @@map("test_steps")
}

model Attempt {
  id                     Int       @id @default(autoincrement())
  userId                 Int
  testId                 Int
  status                 String    // "in_progress" | "completed" | "cancelled"
  currentStep            Int       @default(1)
  startedAt              DateTime  @default(now())
  finishedAt             DateTime?
  lastStepSentAt         DateTime? // When last step was sent (for timeout tracking)
  totalScore             Float?
  level                  String?   // "Junior" | "Middle" | "Senior"
  strengthsJson          String?   // JSON array
  weaknessesJson         String?   // JSON array
  recommendationsJson    String?   // JSON array
  suspicionFlagsJson     String?   // JSON array
  evaluationError        String?
  evaluationResultJson   String?   // JSON: full evaluation result (for virtual customer step details)
  conversationHistoryJson String?  // JSON array of { role: "client"|"manager", text: string } (virtual customer)
  virtualCustomerStateJson String? // JSON: { stage, checklist, notes } (virtual customer)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  test    Test           @relation(fields: [testId], references: [id])
  answers AttemptAnswer[]

  @@map("attempts")
}

model AttemptAnswer {
  id               Int       @id @default(autoincrement())
  attemptId        Int
  stepId           Int
  answerText       String
  createdAt        DateTime  @default(now())
  stepScore        Float?
  criteriaScoresJson String? // JSON object
  feedback         String?
  betterExample    String?

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  step    TestStep @relation(fields: [stepId], references: [id])

  @@map("attempt_answers")
}

// Voice call session: one row per call (same phone can have many sessions = history of calls).
model VoiceCallSession {
  id               Int       @id @default(autoincrement())
  callId           String    @unique  // UUID from start-voice-call
  to               String    // normalized phone +7...
  scenario         String?   // "dialog" | "realtime" | "realtime_pure"
  source           String    @default("manual") // "manual" | "scheduled" | "batch" | "demo"
  dealershipId     String?
  managerId        String?
  planId           String?
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  outcome          String?   // "completed" | "no_answer" | "busy" | "failed" | "disconnected"
  durationSec      Int?      // talk time in seconds (null if no answer)
  transcriptJson   String?   // JSON: [{ role: "manager"|"client", text: string }]
  evaluationJson   String?   // same shape as TrainingSession.evaluationJson (V2)
  dimensionsJson   String?   // JSON: 4 dimension scores extracted from evaluationJson
  checklistResultsJson String? // JSON: checklist results extracted from evaluationJson
  caseContextJson  String?   // JSON: scenario/profile/item context used for the call
  totalScore       Float?    // 0-100
  failureReason    String?   // if early fail

  dealership       Dealership?     @relation(fields: [dealershipId], references: [id], onDelete: SetNull)
  manager          ManagerProfile? @relation(fields: [managerId], references: [id], onDelete: SetNull)
  plan             CallPlan?       @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([dealershipId, startedAt])
  @@index([managerId, startedAt])
  @@index([planId, startedAt])
  @@index([source, startedAt])
  @@map("voice_call_sessions")
}

model CallBatch {
  id              String   @id @default(cuid())
  mode            String   @default("manual") // "manual" | "single_dealership" | "all_dealerships"
  status          String   @default("running") // "running" | "paused" | "cancelled" | "completed"
  title           String?
  maxConcurrency  Int      @default(10)
  startIntervalMs Int      @default(250)
  maxAttempts     Int      @default(3)
  totalJobs       Int      @default(0)
  queuedJobs      Int      @default(0)
  inProgressJobs  Int      @default(0)
  completedJobs   Int      @default(0)
  failedJobs      Int      @default(0)
  cancelledJobs   Int      @default(0)
  retryingJobs    Int      @default(0)
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  jobs CallBatchJob[]

  @@map("call_batches")
}

model CallBatchJob {
  id              String   @id @default(cuid())
  batchId         String
  dealershipId    String?
  dealershipName  String?
  phone           String
  status          String   @default("queued") // "queued" | "dialing" | "in_progress" | "retry_wait" | "completed" | "failed" | "cancelled"
  attempt         Int      @default(0)
  maxAttempts     Int      @default(3)
  queuedAt        DateTime @default(now())
  nextRunAt       DateTime @default(now())
  startedAt       DateTime?
  endedAt         DateTime?
  lastError       String?
  lastOutcome     String?
  lastVoiceCallId String?
  linkedAuditId   String?
  linkReason      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  batch    CallBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  attempts CallBatchAttempt[]

  @@index([batchId, status, nextRunAt])
  @@map("call_batch_jobs")
}

model CallBatchAttempt {
  id          String   @id @default(cuid())
  jobId       String
  attempt     Int
  voiceCallId String   @unique
  status      String   @default("dialing") // "dialing" | "ended"
  outcome     String?
  error       String?
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job CallBatchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, attempt])
  @@map("call_batch_attempts")
}

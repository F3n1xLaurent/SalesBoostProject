# Telegram Bot (from @BotFather) — use TELEGRAM_BOT_TOKEN or BOT_TOKEN
TELEGRAM_BOT_TOKEN=

# OpenAI API
OPENAI_API_KEY=

# AI provider:
# openai   — direct OpenAI API
# proxyapi — OpenAI-compatible ProxyAPI endpoint, https://openai.api.proxyapi.ru/v1
#AI_API_PROVIDER=openai
#PROXYAPI_API_KEY=
#OPENAI_BASE_URL=
#
# Model overrides. For ProxyAPI use provider-prefixed names, e.g.:
# OPENAI_CHAT_MODEL=openai/gpt-4o-mini
# OPENAI_IMPORT_MODEL=openai/gpt-4o-mini
# OPENAI_STT_MODEL=openai/gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=openai/tts-1
# For direct OpenAI use regular names, e.g. gpt-4o-mini.
#OPENAI_CHAT_MODEL=gpt-4o-mini
#OPENAI_IMPORT_MODEL=gpt-4o-mini
#OPENAI_STT_MODEL=gpt-4o-mini-transcribe
#OPENAI_TTS_MODEL=tts-1

# Analytics AI summary (optional). If absent, server uses deterministic fallback.
#ANTHROPIC_API_KEY=
#ANALYTICS_AI_MODEL=claude-sonnet-4-20250514

# Database (SQLite)
# Local: file:./dev.db
# Railway: file:/data/dev.db (with volume mounted at /data)
DATABASE_URL="file:./dev.db"

# Admin Telegram IDs (comma-separated) — required for /admin
ADMIN_TELEGRAM_IDS=123456789,@username

# Production (Railway): HTTPS URL of your app, e.g. https://salesboost.railway.app
# Local dev: leave empty — tunnel will be used
# MINI_APP_URL=https://your-app.railway.app

# Optional: allow admin panel in browser on localhost without Telegram (dev only)
# ALLOW_DEV_ADMIN=true
#
# Локальная админка (Vite): npm run dev + npm run dev:admin → http://127.0.0.1:5173
# API проксируется на http://localhost:3000. В dev сервер всегда слушает HTTP на PORT,
# даже если есть cert.pem/key.pem и MINI_APP_URL=https://... (иначе в браузере «connection failed»).

# Optional: ElevenLabs (TTS for client voice messages)
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# Voice ID from ElevenLabs. If you use an ElevenLabs Agent, put the voice_id assigned to that agent here.
# ELEVENLABS_VOICE_ID=your_voice_id_here
# Optional: ElevenLabs Agent for the trainer runtime. If set, /train sends manager turns
# to this agent and stores the agent audio replies as client voice messages.
# ELEVENLABS_AGENT_ID=agent_xxx

# Optional: Proxy for OpenAI (if API blocked in your region)
# HTTPS_PROXY=http://127.0.0.1:7890

# PORT=3000


# ========== Call-test (Vox smoke-test server) — тестовые звонки ==========
# Нужны для модуля apps/vox-smoke-test-server. Подробно: INTEGRATION-CALL-TEST.md
#VOX_ACCOUNT_ID=10308320
#VOX_API_KEY=...
#VOX_APP_ID=49720003
#VOX_SCENARIO_NAME=smoke_test
#VOX_RULE_NAME=smoke_test_rule
#VOX_CALLER_ID=+79001234567
# Номер по умолчанию для одного тестового звонка (POST /call без body)
#VOX_TEST_TO=+79771231212
# Несколько тестовых номеров для разработки (через запятую, без пробелов)
#VOX_TEST_NUMBERS=+79771231212,+79001234567,+79001234568
#PUBLIC_BASE_URL=https://maintained-logging-recent-ourselves.trycloudflare.com
#VOX_SMOKE_PORT=3001
#DISABLE_VOX_SIGNATURE_CHECK=true

# Голосовой диалог (ASR → наш нейрон → TTS): сценарий voice_dialog и URL основного приложения
# Эти переменные также используются вкладкой «Звонок» в админке (инициация звонка с сервера).
# В dev (ALLOW_DEV_ADMIN=true) туннель localhost.run запускается автоматически при npm run dev;
# URL подхватывается без правки .env — админка и звонки используют его после появления [TUNNEL] в консоли.
# VOICE_DIALOG_BASE_URL / PUBLIC_BASE_URL — запасной URL, если туннель не используется.
#VOICE_DIALOG_BASE_URL=https://your-main-app.trycloudflare.com
# VOICE_USE_STREAM=true — передавать stream_url (WebSocket). Туннели часто не поддерживают WS — используйте false или не задавайте (только POST).
#VOICE_USE_STREAM=false
# Имя сценария в Voximplant для диалога (по умолчанию voice_dialog)
#VOX_DIALOG_SCENARIO_NAME=voice_dialog
# Правило маршрутизации, к которому привязан voice_dialog (обязательно — иначе при dialog: true запустится smoke_test)
#VOX_DIALOG_RULE_NAME=voice_dialog_rule

# OpenAI Realtime (переключение сценария в админке: «OpenAI Realtime»)
# Создайте в Voximplant сценарий voice_realtime (код в voximplant/scenario_voice_realtime.js) и правило voice_realtime_rule.
# Для Realtime сценария используется OPENAI_API_KEY из env (передаётся в customData).
# Realtime 2: по умолчанию используется gpt-realtime-2; для отката можно поставить gpt-realtime или gpt-realtime-mini.
#OPENAI_REALTIME_MODEL=gpt-realtime-2
#OPENAI_REALTIME_REASONING_EFFORT=low
#VOX_REALTIME_RULE_NAME=voice_realtime_rule
#VOX_REALTIME_SCENARIO_NAME=voice_realtime

# Realtime Pure: только промпт, без бэкенда (сценарий voice_realtime_pure)
#VOX_REALTIME_PURE_RULE_NAME=voice_realtime_pure_rule
#VOX_REALTIME_PURE_SCENARIO_NAME=voice_realtime_pure

# ========= Call batch orchestrator (MVP1) =========
# Источник целей для прозвона:
# mock — текущий mock-контур (рекомендуется на этапе MVP)
# real — будущий реальный источник (пока не активирован)
#CALL_SOURCE_MODE=mock

# Автоматический ежедневный прозвон (по умолчанию ВЫКЛЮЧЕН)
#CALL_AUTO_DAILY_ENABLED=false
# Совместимость с кодом:
#AUTO_DAILY_CALLS_ENABLED=false

# Ограничения для авто-батча
#AUTO_DAILY_MAX_CONCURRENCY=10
#AUTO_DAILY_START_INTERVAL_MS=500

# Тестовый режим батча (без реальных звонков; имитация исходов)
#CALL_BATCH_TEST_MODE=false

# Таймаут зависшей задачи in_progress (мс)
#CALL_BATCH_STUCK_TIMEOUT_MS=360000
